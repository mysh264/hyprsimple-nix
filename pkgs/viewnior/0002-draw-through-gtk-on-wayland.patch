diff --git a/src/vnr-crop.c b/src/vnr-crop.c
index 9f8acf7..869eca3 100644
--- a/src/vnr-crop.c
+++ b/src/vnr-crop.c
@@ -43,20 +43,26 @@ static gboolean drawable_motion_cb (GtkWidget *widget,
 /*************************************************************/
 /***** Private actions ***************************************/
 /*************************************************************/
+/* The rectangle is drawn by the image's draw handler, through GTK. Before,
+ * it was drawn straight onto the window, and drawn over again to wipe it,
+ * which only shows on X11: on Wayland there was no rectangle to see. */
+static void
+vnr_crop_paint_rectangle(VnrCrop *crop, cairo_t *cr)
+{
+    cairo_save(cr);
+    cairo_set_operator(cr, CAIRO_OPERATOR_DIFFERENCE);
+    cairo_set_line_width(cr, 3);
+    cairo_rectangle(cr, (int)crop->sub_x + 0.5, (int)crop->sub_y + 0.5, (int)crop->sub_width, (int)crop->sub_height);
+    cairo_set_source_rgba(cr, 1.0, 1.0, 1.0, 1.0);
+    cairo_stroke(cr);
+    cairo_restore(cr);
+}
+
 static void
 vnr_crop_draw_rectangle(VnrCrop *crop)
 {
-    cairo_t *cr;
     if(crop->do_redraw)
-    {
-        cr = gdk_cairo_create(gtk_widget_get_window(crop->image));
-        cairo_set_operator(cr, CAIRO_OPERATOR_DIFFERENCE);
-        cairo_set_line_width(cr, 3);
-        cairo_rectangle(cr, (int)crop->sub_x + 0.5, (int)crop->sub_y + 0.5, (int)crop->sub_width, (int)crop->sub_height);
-        cairo_set_source_rgba(cr, 1.0, 1.0, 1.0, 1.0);
-        cairo_stroke(cr);
-        cairo_destroy(cr);
-    }
+        gtk_widget_queue_draw(crop->image);
 }
 
 static inline void
@@ -295,7 +301,8 @@ drawable_expose_cb (GtkWidget *widget, cairo_t *cr, VnrCrop *crop)
         crop->sub_height = crop->height;
     }
     cairo_restore(cr);
-    vnr_crop_clear_rectangle (crop);
+    if(crop->do_redraw)
+        vnr_crop_paint_rectangle (crop, cr);
 
     return FALSE;
 }
