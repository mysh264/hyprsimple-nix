+static int
+uni_image_view_scroll_event (GtkWidget * widget, GdkEventScroll * ev)
+{
+    UniImageView *view = UNI_IMAGE_VIEW (widget);
+    UniImageViewPrivate *priv = view->priv;
+    VnrWindow *vnr_win = VNR_WINDOW(gtk_widget_get_toplevel(widget));
+    GdkEvent *event = (GdkEvent *) ev;
+    GdkDevice *source;
+    gboolean wheel;
+    gdouble dx = 0, dy = 0;
+    g_assert(gtk_widget_is_toplevel(GTK_WIDGET(vnr_win)));
+
+    if (ev->direction != GDK_SCROLL_SMOOTH)
+    {
+        uni_image_view_scroll_step (view, vnr_win, ev->direction, ev->state, ev->x, ev->y);
+        return TRUE;
+    }
+
+    /* Smooth scrolling. On Wayland a touchpad only scrolls this way, so
+     * without it two fingers did nothing at all. Each whole unit is one
+     * step, as X11 counts a touchpad, and a mouse wheel's click is always
+     * one step, also where it measures 1.5 (Wayland). */
+    if (gdk_event_is_scroll_stop_event (event))
+    {
+        priv->scroll_dx = priv->scroll_dy = 0;
+        return TRUE;
+    }
+    if (!gdk_event_get_scroll_deltas (event, &dx, &dy))
+        return TRUE;
+    source = gdk_event_get_source_device (event);
+    wheel = source == NULL || gdk_device_get_source (source) == GDK_SOURCE_MOUSE;
+
+    /* Only along the way the fingers move most, so a little sideways wobble
+     * while zooming does not turn to the next image. */
+    if (fabs (dx) > fabs (dy))
+        priv->scroll_dx += dx;
+    else
+        priv->scroll_dy += dy;
+
+    while (fabs (priv->scroll_dy) >= 1.0)
+    {
+        gboolean down = priv->scroll_dy > 0;
+        uni_image_view_scroll_step (view, vnr_win,
+                                    down ? GDK_SCROLL_DOWN : GDK_SCROLL_UP,
+                                    ev->state, ev->x, ev->y);
+        priv->scroll_dx = 0;
+        if (wheel)
+        {
+            priv->scroll_dy = 0;
+            break;
+        }
+        priv->scroll_dy += down ? -1.0 : 1.0;
+    }
+    while (fabs (priv->scroll_dx) >= 1.0)
+    {
+        gboolean right = priv->scroll_dx > 0;
+        uni_image_view_scroll_step (view, vnr_win,
+                                    right ? GDK_SCROLL_RIGHT : GDK_SCROLL_LEFT,
+                                    ev->state, ev->x, ev->y);
+        priv->scroll_dy = 0;
+        if (wheel)
+        {
+            priv->scroll_dx = 0;
+            break;
+        }
+        priv->scroll_dx += right ? -1.0 : 1.0;
+    }
+
     return TRUE;
 }
 
