+double parse_timezone_offset(const char *tz_name, time_t when) {
+  // A corrupted config value on the load path bypasses location_detect's
+  // check, so the name is validated here as well.
+  if (!timezone_name_is_valid(tz_name))
+    return 0.0;
+
+  // GLib looks a name up under TZDIR, or under /usr/share/zoneinfo when TZDIR
+  // is unset, and nowhere else. A zone that timezone_exists found in one of
+  // the other roots was accepted, and then read as UTC+0: on NixOS, where the
+  // database is /etc/zoneinfo, every prayer time came out hours off for a
+  // program started without TZDIR. GLib also takes an absolute path, so it is
+  // given the file found here. The bare name stays the fallback, for a zone
+  // GLib knows without a file, such as "UTC".
+  char path[512];
+  GTimeZone *tz = zone_file(tz_name, path, sizeof(path)) ? g_time_zone_new_identifier(path) : NULL;
+  if (!tz)
+    tz = g_time_zone_new_identifier(tz_name);
+  if (!tz)
+    return 0.0;
+
+  gint64 instant = (gint64)when;
+  gint interval = g_time_zone_find_interval(tz, G_TIME_TYPE_UNIVERSAL, instant);
+  double offset = interval < 0 ? 0.0 : (double)g_time_zone_get_offset(tz, interval) / 3600.0;
+  g_time_zone_unref(tz);
+  return offset;
+}
