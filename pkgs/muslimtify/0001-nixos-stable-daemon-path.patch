+    if (n > 0 && (size_t)n < sizeof(nixos_user_profile))
+      candidates[count++] = nixos_user_profile;
+  }
   const char *dir = platform_exe_dir();
   if (dir && dir[0] != '\0') {
     int n = snprintf(sibling, cap, "%s/muslimtify", dir);
