 # Enable fzf
 if command -v fzf >/dev/null 2>&1; then
   eval "$(fzf --bash)"
@@ -21,6 +16,14 @@ if command -v starship >/dev/null 2>&1; then
   eval "$(starship init bash)"
 fi
 
+# Enable zoxide, after starship. starship's init moves whatever is already in
+# PROMPT_COMMAND into its own hook, so a zoxide set up before it loses its
+# entry there, and zoxide 0.10 then warns on every first `cd` of a terminal
+# that it is "not initialized at the end". zoxide asks to be set up last.
+if command -v zoxide >/dev/null 2>&1; then
+  eval "$(zoxide init --cmd cd bash)"
+fi
