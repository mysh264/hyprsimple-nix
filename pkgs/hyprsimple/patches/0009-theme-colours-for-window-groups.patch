diff --git a/.config/hypr/themes/templates/hyprland-colors.lua.tpl b/.config/hypr/themes/templates/hyprland-colors.lua.tpl
index 04c0603..b36dc35 100644
--- a/.config/hypr/themes/templates/hyprland-colors.lua.tpl
+++ b/.config/hypr/themes/templates/hyprland-colors.lua.tpl
@@ -5,4 +5,48 @@ hl.config({
       inactive_border = "rgb({{ color8_strip }})",
     },
   },
+  -- hyprsimple-nix: window groups in the theme's colours, the way the bar
+  -- draws its workspaces: the active tab in the accent with the background
+  -- colour on it, the others on the bar's surface.
+  group = {
+    col = {
+      border_active = "rgb({{ accent_strip }})",
+      border_inactive = "rgb({{ color8_strip }})",
+    },
+    groupbar = {
+      text_color = "rgb({{ background_strip }})",
+      text_color_inactive = "rgb({{ foreground_strip }})",
+      col = {
+        active = "rgb({{ accent_strip }})",
+        inactive = "rgb({{ surface_strip }})",
+      },
+    },
+  },
 })
+
+-- hyprsimple-nix: the tabs of the i3 layout (the hy3 plugin), when it is
+-- loaded, in the same colours.
+if hl.plugin.hy3 ~= nil then
+  hl.config({
+    plugin = {
+      hy3 = {
+        tabs = {
+          colors = {
+            active = "rgb({{ accent_strip }})",
+            active_border = "rgb({{ accent_strip }})",
+            active_text = "rgb({{ background_strip }})",
+            active_alt_monitor = "rgb({{ surface_strip }})",
+            active_alt_monitor_border = "rgb({{ color8_strip }})",
+            active_alt_monitor_text = "rgb({{ foreground_strip }})",
+            focused = "rgb({{ surface_strip }})",
+            focused_border = "rgb({{ accent_strip }})",
+            focused_text = "rgb({{ foreground_strip }})",
+            inactive = "rgb({{ surface_strip }})",
+            inactive_border = "rgb({{ surface_strip }})",
+            inactive_text = "rgb({{ foreground_strip }})",
+          },
+        },
+      },
+    },
+  })
+end
