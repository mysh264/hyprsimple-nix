diff --git a/.local/bin/hyprsimple-update.sh b/.local/bin/hyprsimple-update.sh
index 763be7f..d2a4edb 100755
--- a/.local/bin/hyprsimple-update.sh
+++ b/.local/bin/hyprsimple-update.sh
@@ -138,9 +138,27 @@ latest_release_tag() {
     sort -V | tail -1 | cut -f2
 }
 
+# hyprsimple-nix: on NixOS the hyprsimple version is chosen by the NixOS
+# configuration (programs.hyprsimple), which links it at /etc/hyprsimple/source.
+# There is no remote to pull and no channel to switch: an update copies that
+# version into $HYPRSIMPLE_PATH and then does everything below as usual.
+HYPRSIMPLE_NIXOS=""
+[[ -e /etc/hyprsimple/source ]] && HYPRSIMPLE_NIXOS=1
+
+if [[ -n $HYPRSIMPLE_NIXOS && -n $CHANNEL_ARG ]]; then
+  echo -e "${RED}On NixOS the hyprsimple version comes from your NixOS configuration, so '$CHANNEL_ARG' does not apply.${NC}"
+  echo "Update the hyprsimple-nix flake input and rebuild, then run hyprsimple-update."
+  echo "To follow another branch, see 'Tracking main' in the hyprsimple-nix README."
+  exit 1
+fi
+
 if [[ ! -d $HYPRSIMPLE_PATH ]]; then
   echo -e "${RED}hyprsimple is not installed at $HYPRSIMPLE_PATH.${NC}"
-  echo "Re-run ./install.sh from a fresh clone to set it up."
+  if [[ -n $HYPRSIMPLE_NIXOS ]]; then
+    echo "Run hyprsimple-install to set it up for this user."
+  else
+    echo "Re-run ./install.sh from a fresh clone to set it up."
+  fi
   exit 1
 fi
 
@@ -151,7 +169,13 @@ fi
 PREV_COMMIT=""
 [[ -d $HYPRSIMPLE_PATH/.git ]] && PREV_COMMIT=$(git -C "$HYPRSIMPLE_PATH" rev-parse HEAD 2>/dev/null)
 
-if [[ -d $HYPRSIMPLE_PATH/.git ]]; then
+if [[ -n $HYPRSIMPLE_NIXOS ]]; then
+  # Copies the version your NixOS configuration provides into
+  # $HYPRSIMPLE_PATH and records it as a commit, so PREV_COMMIT above still
+  # names what this machine had before and the reports at the end still work.
+  hyprsimple-nixos sync
+  CHANNEL_LABEL="from your NixOS configuration"
+elif [[ -d $HYPRSIMPLE_PATH/.git ]]; then
   echo -e "${YELLOW}Pulling latest hyprsimple...${NC}"
 
   if [[ -n $(git -C "$HYPRSIMPLE_PATH" status --porcelain) ]]; then
@@ -317,6 +341,11 @@ if [[ -r $AUR_DETECT ]]; then
 fi
 
 echo -e "\n${YELLOW}Checking for newly required packages...${NC}"
+if [[ -n $HYPRSIMPLE_NIXOS ]]; then
+  # Packages come from the NixOS configuration, never from pacman. This only
+  # reports a package this version lists that hyprsimple-nix does not provide.
+  hyprsimple-nixos check-packages || true
+else
 install_missing_packages "$HYPRSIMPLE_PATH/packages.txt" "sudo pacman"
 if [[ -n $AUR_HELPER ]]; then
   install_missing_packages "$HYPRSIMPLE_PATH/aur-packages.txt" "$AUR_HELPER"
@@ -325,6 +354,7 @@ else
   # the AUR list reads as an update that found nothing to do there.
   echo -e "${YELLOW}No AUR helper, so AUR packages were not checked. Install paru or yay.${NC}"
 fi
+fi
 
 # ---- Migrations ----------------------------------------------------------
 
