diff --git a/default/quickshell/bar/BarPeekEdge.qml b/default/quickshell/bar/BarPeekEdge.qml
new file mode 100644
index 0000000..9e11874
--- /dev/null
+++ b/default/quickshell/bar/BarPeekEdge.qml
@@ -0,0 +1,34 @@
+import QtQuick
+import Quickshell
+import Quickshell.Wayland
+import qs.theme
+
+// hyprsimple-nix: a thin strip along the bar's edge of the screen, invisible,
+// there only while the bar is hidden (programs.hyprsimple.bar.peek.enable).
+// The pointer touching it brings the bar back over the windows: see
+// shell.qml. Its ends are left to the hot corners. It stays below a window in
+// full screen, like the bar.
+PanelWindow {
+    id: edge
+
+    required property var modelData
+    // Shown: the bar is hidden and not already brought back.
+    property bool active: false
+    signal entered()
+
+    screen: modelData
+    visible: active
+    anchors { top: !Theme.barAtBottom; bottom: Theme.barAtBottom; left: true; right: true }
+    margins.left: Theme.barPeekInset
+    margins.right: Theme.barPeekInset
+    implicitHeight: Theme.barPeekEdge
+    exclusionMode: ExclusionMode.Ignore
+    color: "transparent"
+    WlrLayershell.namespace: "quickshell-peek"
+
+    MouseArea {
+        anchors.fill: parent
+        hoverEnabled: true
+        onEntered: edge.entered()
+    }
+}
diff --git a/default/quickshell/shell.qml b/default/quickshell/shell.qml
index 7dff347..2a8212f 100644
--- a/default/quickshell/shell.qml
+++ b/default/quickshell/shell.qml
@@ -28,6 +28,34 @@ ShellRoot {
     // The bars are hidden, with the shell still running. Notifications need it running.
     property bool barsHidden: false
 
+    // hyprsimple-nix: hidden bars shown for a moment, over the windows, because
+    // the pointer came to the bar's edge of the screen (Theme.barPeek). They go
+    // again a little after the pointer has left them, or has only touched the
+    // edge, unless a panel is open.
+    property bool barsPeeking: false
+    onBarsHiddenChanged: barsPeeking = false
+    readonly property bool peekHovered: bars.instances.some(bar => bar.hovered)
+    onPeekHoveredChanged: if (!peekHovered) peekLinger.restart()
+    onPanelOwnerChanged: if (panelOwner === null) peekLinger.restart()
+
+    Timer {
+        id: peekLinger
+        interval: Theme.barPeekLingerMs
+        onTriggered: if (!root.peekHovered && root.panelOwner === null) root.barsPeeking = false
+    }
+
+    Variants {
+        model: Theme.barPeek ? Quickshell.screens : []
+
+        BarPeekEdge {
+            active: root.barsHidden && !root.barsPeeking
+            onEntered: {
+                root.barsPeeking = true
+                peekLinger.restart()
+            }
+        }
+    }
+
     // A screen recording is running, as told over ipc. Whatever told it can be
     // wrong or never call back: a test once reported a recording that did not exist.
     // So while it is lit the shell looks for a recorder itself and clears it when there is none.
@@ -82,7 +110,8 @@ ShellRoot {
 
         Bar {
             pluginRegistry: externalPlugins
-            visible: !root.barsHidden
+            visible: !root.barsHidden || root.barsPeeking
+            peeking: root.barsHidden && root.barsPeeking
             recording: root.recording
             stats: systemStats
             idle: idleWatch
