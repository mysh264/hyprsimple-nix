@@ -67,12 +67,29 @@ if grep -qsF '# >>> hyprsimple nvidia >>>' "$CONFIG/uwsm/env"; then
   has_nvidia_block=1
 fi
 
+# On NixOS (hyprsimple-nix), the packages and the system settings come from
+# the NixOS configuration, and Part 2 of hyprsimple-nix's removal guide takes
+# them out. /etc/hyprsimple/source is the hyprsimple version it provides.
+NIXOS=""
+[[ -e /etc/hyprsimple/source ]] && NIXOS=1
+REMOVAL_GUIDE="https://github.com/mysh264/hyprsimple-nix/blob/main/docs/uninstall.md#part-2-for-the-computer"
+
 # Whether the checkout holds anything that exists nowhere else. A checkout git
 # cannot answer for counts as holding something.
 checkout_is_disposable() {
   local status unpushed
   status=$(git -C "$CHECKOUT" status --porcelain 2>/dev/null) || return 1
   [[ -z $status ]] || return 1
+  # Work put aside with git stash is in no commit, and would go with the
+  # checkout.
+  [[ -z $(git -C "$CHECKOUT" stash list 2>/dev/null) ]] || return 1
+  if [[ -n $NIXOS ]]; then
+    # On NixOS the checkout has no remote. Each of its commits is a version
+    # hyprsimple-nix copied in from the system, which it can do again; a commit
+    # by anyone else exists nowhere else.
+    [[ -z $(git -C "$CHECKOUT" log --format=%ae 2>/dev/null | grep -vx 'hyprsimple-nix@localhost') ]]
+    return
+  fi
   unpushed=$(git -C "$CHECKOUT" rev-list HEAD --not --remotes --tags -1 2>/dev/null) || return 1
   [[ -z $unpushed ]]
 }
